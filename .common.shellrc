#!/usr/bin/env bash

# base
export LC_CTYPE=en_US.UTF-8
export LANG=en_US.UTF-8
export EDITOR="nvim"
export SVDIR=~/service
export TERM=screen-256color # xterm-256color

# colours
blu=$(printf "\033\\[1;34m")
clr=$(printf "\033\\[m")
grn=$(printf "\033\\[32m")
gry=$(printf "\033\\[37m")
mag=$(printf "\033\\[35m")
red=$(printf "\033\\[31m")

export blu clr grn gry mag red

# gnu tools
command -v gls > /dev/null && alias ls=gls
command -v gdircolors > /dev/null && alias dircolors=gdircolors

# turn off xon/xoff to avoid conflict with CTRL-s readline forward search
stty -ixon

# aliases
alias ....="cd ../../.."
alias ...="cd ../.."
alias ..="cd .."
alias clear="echo use CTRL-L instead. && false"
alias e='emacs -nw'
alias gist='gist -p'
alias gst='git status'
alias gti='git'
alias i='irssi-customized'
alias l='ls --color -alFh'
alias less='less -R' # interpret color
alias ll='ls --color -bF'
alias m='mutt'
alias nhn="sudo ipfw add 70000 deny tcp from any to news.ycombinator.com"
alias potoday='2>/dev/null cat $(plog) | grep completed\. | wc -l'
alias pwdc="pwd | pbcopy"
alias s='soywiki'
alias tree='tree -C' # color
alias v='vim .'
alias vi='vim'
alias vim='nvim'
alias ytop="ytop -c monokai"
alias k="kubectl"

# base
export PATH=~/bin:/usr/local/bin:/usr/bin:/bin:/usr/local/sbin:/usr/sbin:/sbin

# mode
export FOCUS=${FOCUS:-s}
alias work='source solarized --theme light && FOCUS=s t'
alias fun='source solarized --theme dark && FOCUS=b t'

# other
export SOYWIKI_VIM="nvim"

# only run once on login shell. allows tmux reconfigurations
source solarized --theme light --skip-if-configured

# cabal
export PATH=$PATH:~/.cabal/bin

# conscript
export PATH=$PATH:~/.conscript/bin

# flutter
export PATH=~/src/github.com/flutter/flutter/bin:$PATH

# pg
export PATH="/opt/homebrew/opt/postgresql@13/bin:$PATH"

# identity per focus. exported rather than written with `git config --global`,
# which would rewrite ~/.gitconfig -- a symlink into the dotfiles repo -- on
# every shell start and leave the working tree permanently dirty.

# work
if [[ $FOCUS == 's' ]]; then
  export PATH=$PATH:~/.work/bin
  export GIT_AUTHOR_EMAIL="rany@reflectionlabs.com"
fi

# play
if [[ $FOCUS == 'b' ]]; then
  export GIT_AUTHOR_EMAIL="purzelrakete@gmail.com"
fi

export GIT_COMMITTER_EMAIL="$GIT_AUTHOR_EMAIL"

# osx
uname -a | grep "^Darwin" >/dev/null && source ~/.osx

# linux
uname -a | grep "^Linux" >/dev/null && source ~/.linux

# go
export PATH=$PATH:/usr/local/go/bin
export GOPATH=~
export PATH=$PATH:$GOPATH/bin

# openssl
export PATH="/usr/local/opt/openssl/bin:$PATH"

# extension point
for ext in ~/.common/*; do
  source "$ext"
done

# python
export PATH=~/.local/bin:$PATH

# conda
# export PATH=$PATH:~/anaconda3/bin

# ripgrep
function rg() {
  command rg -p "$@" | less -R
}

# nvm
#
# sourcing nvm.sh costs ~460ms per shell, nearly all of it nvm_auto running
# `nvm use default` and re-verifying the version. that answer only changes when
# a version is installed or the default alias moves, so resolve it once, cache
# it, and put the bin dir on PATH directly. nvm itself loads on first use.
export NVM_DIR="$HOME/.nvm"

if [ -s "$NVM_DIR/nvm.sh" ]; then
  nvm_bin_cache="${XDG_CACHE_HOME:-$HOME/.cache}/nvm-default-bin"

  # stale when the default alias moved or a version was added or removed.
  if [ ! -s "$nvm_bin_cache" ] ||
     [ "$NVM_DIR/alias/default" -nt "$nvm_bin_cache" ] ||
     [ "$NVM_DIR/versions/node" -nt "$nvm_bin_cache" ]; then
    mkdir -p "$(dirname "$nvm_bin_cache")"
    # --no-use skips the nvm_auto that makes plain sourcing so expensive.
    \. "$NVM_DIR/nvm.sh" --no-use
    # guarded: `dirname ""` is ".", which would put the cwd on PATH.
    nvm_default_node="$(nvm which default 2>/dev/null)"
    [ -n "$nvm_default_node" ] && dirname "$nvm_default_node" > "$nvm_bin_cache"
    unset nvm_default_node
  fi

  [ -s "$nvm_bin_cache" ] && export PATH="$(cat "$nvm_bin_cache"):$PATH"
  unset nvm_bin_cache

  # first `nvm ...` replaces this shim with the real thing.
  if ! command -v nvm > /dev/null; then
    nvm() {
      unset -f nvm
      \. "$NVM_DIR/nvm.sh" --no-use
      [ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"
      nvm "$@"
    }
  fi
fi

# stable ssh agent socket: each ssh login gets a fresh forwarded socket, but
# shells inside a long-lived tmux keep the one from when they started. point
# ~/.ssh/ssh_auth_sock at the newest live socket on login, and have tmux
# shells use the link, so they follow reattaches.
ssh_auth_link="$HOME/.ssh/ssh_auth_sock"
if [ -z "$TMUX" ] && [ -n "$SSH_CONNECTION" ] && [ -S "$SSH_AUTH_SOCK" ] \
   && [ "$SSH_AUTH_SOCK" != "$ssh_auth_link" ]; then
  mkdir -p "$HOME/.ssh" && ln -sf "$SSH_AUTH_SOCK" "$ssh_auth_link"
fi
if [ -n "$TMUX" ] && [ -S "$ssh_auth_link" ]; then
  export SSH_AUTH_SOCK="$ssh_auth_link"
fi
unset ssh_auth_link

# fix ssh agent
function fixsshagent() {
  for s in $(ps e | sed -n  's/.*SSH_AUTH_SOCK=\([^ ]*\) .*/\1/p' | sort -u)
  do
    if [ -S $s ]
    then
      export SSH_AUTH_SOCK=$s
    fi
  done
}

# fzf
export FZF_DEFAULT_COMMAND='rg --files'

if [[ $SOLARIZED_MODE == 'dark' ]]; then
  export FZF_COLORS="
    --color fg:-1,bg:-1,hl:33,fg+:254,bg+:-1,hl+:33
    --color info:136,prompt:136,pointer:230,marker:230,spinner:136
  "
fi

if [[ $SOLARIZED_MODE == 'light' ]]; then
  export FZF_COLORS="
    --color fg:-1,bg:-1,hl:33,fg+:254,bg+:-1,hl+:33
    --color info:136,prompt:136,pointer:230,marker:230,spinner:136
  "
fi

export FZF_DEFAULT_OPTS="$FZF_COLORS -m --height 50%"

# homebrew.
#
# the PATH reset above drops homebrew's prefix; this puts it back. same caching
# as in .zshrc -- `brew shellenv` prints a constant script for a given shell,
# so keep one cache per shell and source that instead of forking brew.
# skipped entirely on machines without homebrew (e.g. linux hosts).
for brew_bin in /opt/homebrew/bin/brew /home/linuxbrew/.linuxbrew/bin/brew; do
  [ -x "$brew_bin" ] && break
done

if [ -x "$brew_bin" ]; then
  brew_shell="${ZSH_NAME:-${BASH##*/}}"
  brew_env="${XDG_CACHE_HOME:-$HOME/.cache}/brew-shellenv.${brew_shell:-sh}"

  if [ ! -s "$brew_env" ] || [ "$brew_bin" -nt "$brew_env" ]; then
    mkdir -p "${brew_env%/*}"
    "$brew_bin" shellenv "${brew_shell:-sh}" > "$brew_env"
  fi

  . "$brew_env"
  unset brew_env brew_shell
fi
unset brew_bin

welcome
